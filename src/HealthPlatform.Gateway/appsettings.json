{
  "Authentication": {
    "Authority": "http://localhost:8080/realms/health"
  },
  "ReverseProxy": {
    "Routes": {
      "api": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5100"
          }
        }
      }
    }
  }
}