@page "/auth-unavailable"
<PageTitle>Service d’identité indisponible — HealthPlatform</PageTitle>
<div class="auth-shell"><MedicalCard Title="Service de connexion indisponible" Subtitle="Keycloak ne répond pas sur localhost:8080" Icon="@Icons.Material.Filled.CloudOff">
    <EmptyState Title="Impossible de se connecter pour le moment" Description="Démarrez Docker Desktop, puis relancez setup.cmd sans l’option -SkipDocker." Icon="@Icons.Material.Filled.SettingsPower">
        <Action><MudButton Href="/" Variant="Variant.Outlined" Color="Color.Primary">Retour à l’accueil</MudButton></Action>
    </EmptyState>
</MedicalCard></div>
