<article class="entity-card">
    <div class="entity-card__avatar"><MudIcon Icon="@Icons.Material.Filled.Science" /></div>
    <div class="entity-card__content"><strong>@Title</strong><span>@Summary</span><small>@At.ToLocalTime().ToString("dd MMMM yyyy") · @Source</small></div>
    <StatusBadge Text="@Status" Tone="info" Icon="@Icons.Material.Filled.FactCheck" />
</article>
@code { [Parameter] public string Title { get; set; } = string.Empty; [Parameter] public string Summary { get; set; } = string.Empty; [Parameter] public string Source { get; set; } = string.Empty; [Parameter] public DateTime At { get; set; } [Parameter] public string Status { get; set; } = "Disponible"; }
